[Unit]
Description=AstroGate CPU speech recognition
After=network.target

[Service]
User=astrogate-speech
Group=astrogate-speech
WorkingDirectory=/opt/astrogate-speech
Environment=SPEECH_THREADS=4
Environment=HF_HUB_OFFLINE=1
Environment=OMP_NUM_THREADS=4
ExecStart=/opt/astrogate-speech/venv/bin/uvicorn worker:app --host 127.0.0.1 --port 18890 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=4G
CPUQuota=800%

[Install]
WantedBy=multi-user.target
